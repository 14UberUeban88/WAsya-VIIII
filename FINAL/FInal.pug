doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Сайт-визитка
    link(rel="stylesheet" href="https://cloudflare.com")
    link(rel="stylesheet" href="images/fin.css")
  body

    //- Секция 1: О компании / О себе
    section.about
      img(src="images/profile.jpg" alt="Логотип компании")
      h1 Наша компания
      p Мы предоставляем качественные услуги по разработке цифровых продуктов.
      ul
        li Разработка сайтов под ключ
        li Дизайн интерфейсов
        li Продвижение и SEO

    //- Секция 2: Портфолио
    section.portfolio
      h2 Наши проекты
      .gallery
        .project
          img(src="images/project1.jpg" alt="Проект Интернет-магазин")
          p Интернет-магазин одежды
          a(href="https://github.com" target="_blank") Ссылка на проект
        .project
          img(src="images/project2.jpg" alt="Проект Лендинг")
          p Адаптивный лендинг
          a(href="https://github.com" target="_blank") Ссылка на проект

    //- Секция 3: Отзывы
    section.reviews
      h2 Отзывы клиентов
      .review-card
        img(src="images/client1.jpg" alt="Клиент Иван")
        h3 Иван Петров
        p "Отличная работа! Сайт летает и на телефоне, и на компьютере."
      .review-card
        img(src="images/client2.jpg" alt="Клиент Анна")
        h3 Анна Сидорова
        p "Все сделали быстро и аккуратно. Рекомендую!"

    //- Секция 4: Контакты и Форма
    section.contacts
      h2 Контакты
      
      //- Интерактивные контакты
      address
        p Адрес: г. Москва, ул. Ленина, д. 1
        p Телефон: 
          a(href="tel:+79991234567") +7 (999) 123-45-67
        p Email: 
          a(href="mailto:info@example.com") info@example.com
      
      //- Иконки соцсетей
      .socials
        a(href="https://github.com" target="_blank")
          i.fab.fa-github
        a(href="https://telegram.org" target="_blank")
          i.fab.fa-telegram

      //- Форма связи
      form(action="#" method="POST")
        input(type="text" placeholder="Ваше имя" required)
        input(type="email" placeholder="Ваш email" required)
        textarea(placeholder="Ваше сообщение" required)
        button(type="submit") Отправить
